							</li>
							<li>
								<div class="feature-icon"><i class="bi bi-clock-history"></i></div>
								<div>Tracks time saved from watching at higher speeds</div>
							</li>
						</ul>

						<h4 class="mt-4 mb-3 fw-bold"><i class="bi bi-check-circle-fill text-success"></i> Browser Compatibility</h4>
