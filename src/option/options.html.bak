<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>YouTube Playback Speed Control - Options</title>
	
	<!-- Bootstrap CSS from CDN -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
	
	<!-- Bootstrap Icons from CDN -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
	
	<style>
		:root {
			--primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			--primary-color: #5e72e4;
			--success-color: #2dce89;
			--danger-color: #f5365c;
			--text-primary: #32325d;
			--text-secondary: #525f7f;
			--border-color: #e9ecef;
		}

		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			background: var(--primary-gradient);
			min-height: 100vh;
			padding: 30px 15px;
			font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		}

		.options-container {
			max-width: 900px;
			margin: 0 auto;
			background: white;
			border-radius: 16px;
			box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
			overflow: hidden;
			animation: slideUp 0.5s ease-out;
		}

		@keyframes slideUp {
			from {
				opacity: 0;
				transform: translateY(20px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		.header {
			background: var(--primary-gradient);
			color: white;
			padding: 40px 30px;
			text-align: center;
			position: relative;
			overflow: hidden;
		}

		.header::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="rgba(255,255,255,0.1)" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,112C672,96,768,96,864,112C960,128,1056,160,1152,160C1248,160,1344,128,1392,112L1440,96L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>') no-repeat bottom;
			background-size: cover;
			opacity: 0.3;
		}

		.header-content {
			position: relative;
			z-index: 1;
		}

		.header h1 {
			font-size: 2rem;
			margin: 0 0 10px 0;
			font-weight: 700;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 12px;
		}

		.header h1 i {
			font-size: 2.2rem;
			animation: pulse 2s infinite;
		}

		@keyframes pulse {
			0%, 100% {
				transform: scale(1);
			}
			50% {
				transform: scale(1.1);
			}
		}

		.header p {
			margin: 0;
			font-size: 1rem;
			opacity: 0.95;
		}

		.time-saved-badge {
			background: linear-gradient(135deg, var(--success-color) 0%, #20bf6b 100%);
			color: white;
			padding: 20px 30px;
			margin: 25px;
			border-radius: 12px;
			display: flex;
			align-items: center;
			gap: 20px;
			box-shadow: 0 4px 15px rgba(45, 206, 137, 0.3);
			transition: transform 0.3s ease;
		}

		.time-saved-badge:hover {
			transform: translateY(-2px);
			box-shadow: 0 6px 20px rgba(45, 206, 137, 0.4);
		}

		.time-saved-badge i {
			font-size: 2.5rem;
			opacity: 0.9;
		}

		.time-saved-content {
			flex: 1;
		}

		.time-saved-badge h5 {
			margin: 0 0 5px 0;
			font-size: 0.9rem;
			font-weight: 600;
			opacity: 0.9;
			text-transform: uppercase;
			letter-spacing: 0.5px;
		}

		.time-saved-badge p {
			margin: 0;
			font-size: 1.3rem;
			font-weight: 700;
		}

		.nav-tabs {
			border-bottom: 2px solid var(--border-color);
			padding: 0 30px;
			background: #f8f9fa;
		}

		.nav-tabs .nav-link {
			color: var(--text-secondary);
			border: none;
			padding: 15px 20px;
			font-weight: 500;
			font-size: 0.95rem;
			transition: all 0.3s ease;
			position: relative;
		}

		.nav-tabs .nav-link:hover {
			color: var(--primary-color);
			background: transparent;
		}

		.nav-tabs .nav-link.active {
			color: var(--primary-color);
			background: white;
			border: none;
			border-bottom: 3px solid var(--primary-color);
			font-weight: 600;
		}

		.nav-tabs .nav-link i {
			margin-right: 6px;
			font-size: 1rem;
		}

		.tab-content {
			padding: 35px 30px;
			min-height: 400px;
		}

		.settings-section {
			background: #ffffff;
			border: 1px solid var(--border-color);
			border-radius: 12px;
			padding: 25px;
			margin-bottom: 20px;
			transition: all 0.3s ease;
		}

		.settings-section:hover {
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
			border-color: #dee2e6;
		}

		.section-header {
			display: flex;
			align-items: center;
			gap: 15px;
			margin-bottom: 20px;
		}

		.section-icon {
			width: 45px;
			height: 45px;
			background: linear-gradient(135deg, var(--primary-color) 0%, #825ee4 100%);
			border-radius: 10px;
			display: flex;
			align-items: center;
			justify-content: center;
			color: white;
			font-size: 1.3rem;
		}

		.section-title {
			font-size: 1.2rem;
			font-weight: 700;
			color: var(--text-primary);
			margin: 0;
		}

		.form-label {
			font-weight: 600;
			color: var(--text-primary);
			margin-bottom: 8px;
			font-size: 0.9rem;
			display: flex;
			align-items: center;
			gap: 6px;
		}

		small.text-muted {
			font-size: 0.825rem;
			color: #8898aa !important;
		}

		.form-select,
		.form-control {
			border: 2px solid var(--border-color);
			border-radius: 8px;
			padding: 12px 15px;
			font-size: 0.95rem;
			transition: all 0.3s ease;
		}

		.form-select:focus,
		.form-control:focus {
			border-color: var(--primary-color);
			box-shadow: 0 0 0 0.25rem rgba(94, 114, 228, 0.15);
			outline: none;
		}

		.form-check {
			padding: 12px 0;
		}

		.form-check-input {
			width: 1.2em;
			height: 1.2em;
			margin-top: 0.15em;
			cursor: pointer;
			border: 2px solid var(--border-color);
		}

		.form-check-input:checked {
			background-color: var(--primary-color);
			border-color: var(--primary-color);
		}

		.form-check-input:focus {
			border-color: var(--primary-color);
			box-shadow: 0 0 0 0.25rem rgba(94, 114, 228, 0.15);
		}

		.form-check-label {
			color: var(--text-primary);
			font-weight: 500;
			cursor: pointer;
			display: flex;
			align-items: center;
			gap: 8px;
		}

		.form-switch .form-check-input {
			width: 2.5em;
			cursor: pointer;
		}

		.option-card {
			display: block;
			border: 2px solid var(--border-color);
			border-radius: 10px;
			padding: 15px;
			cursor: pointer;
			transition: all 0.3s ease;
			position: relative;
			height: 100%;
		}

		.option-card:hover {
			border-color: var(--primary-color);
			background: #f8f9fe;
			transform: translateY(-2px);
			box-shadow: 0 4px 12px rgba(94, 114, 228, 0.15);
		}

		.option-card input[type="radio"] {
			position: absolute;
			top: 12px;
			right: 12px;
			width: 1.2em;
			height: 1.2em;
			cursor: pointer;
		}

		.option-card input[type="radio"]:checked ~ .option-content {
			color: var(--primary-color);
		}

		.option-card input[type="radio"]:checked {
			background-color: var(--primary-color);
			border-color: var(--primary-color);
		}

		.option-card input[type="radio"]:checked + .option-content {
			color: var(--primary-color);
		}

		.option-card:has(input[type="radio"]:checked) {
			border-color: var(--primary-color);
			background: linear-gradient(135deg, rgba(94, 114, 228, 0.05) 0%, rgba(130, 94, 228, 0.05) 100%);
		}

		.option-content {
			padding-right: 30px;
			transition: all 0.3s ease;
		}

		.option-title {
			font-weight: 700;
			font-size: 0.95rem;
			color: var(--text-primary);
			margin-bottom: 4px;
		}

		.option-desc {
			font-size: 0.8rem;
			color: var(--text-secondary);
		}

		.btn-action {
			border: none;
			padding: 14px 35px;
			font-weight: 600;
			border-radius: 10px;
			font-size: 1rem;
			cursor: pointer;
			transition: all 0.3s ease;
			display: inline-flex;
			align-items: center;
			gap: 8px;
		}

		.btn-save {
			background: linear-gradient(135deg, var(--success-color) 0%, #20bf6b 100%);
			color: white;
		}

		.btn-save:hover {
			transform: translateY(-2px);
			box-shadow: 0 6px 20px rgba(45, 206, 137, 0.4);
		}

		.btn-reset {
			background: linear-gradient(135deg, var(--danger-color) 0%, #f56036 100%);
			color: white;
		}

		.btn-reset:hover {
			transform: translateY(-2px);
			box-shadow: 0 6px 20px rgba(245, 54, 92, 0.4);
		}

		.alert {
			border-radius: 10px;
			border: none;
			padding: 16px 20px;
			margin-bottom: 25px;
			display: none;
			animation: slideDown 0.3s ease-out;
		}

		@keyframes slideDown {
			from {
				opacity: 0;
				transform: translateY(-10px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		.alert-success {
			background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
			color: #155724;
			border-left: 4px solid var(--success-color);
		}

		.alert-info {
			background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
			color: #0c5460;
			border-left: 4px solid #17a2b8;
		}

		.welcome-card {
			background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
			border-radius: 12px;
			padding: 25px;
			margin-bottom: 20px;
			color: var(--text-primary);
		}

		.welcome-card h2 {
			color: var(--primary-color);
		}

		.tip-box {
			background: linear-gradient(135deg, #fff3cd 0%, #fff5db 100%);
			border-left: 4px solid #ffc107;
			border-radius: 10px;
			padding: 16px 20px;
			margin-top: 20px;
			font-size: 0.9rem;
		}

		.tip-box strong {
			color: #856404;
		}

		.feature-list {
			list-style: none;
			padding: 0;
			margin: 0;
		}

		.feature-list li {
			padding: 12px 0;
			border-bottom: 1px solid var(--border-color);
			display: flex;
			align-items: flex-start;
			gap: 15px;
			font-size: 0.95rem;
			transition: all 0.2s ease;
		}

		.feature-list li:last-child {
			border-bottom: none;
		}

		.feature-list li:hover {
			background: #f8f9fa;
			padding-left: 10px;
			border-radius: 6px;
		}

		.feature-icon {
			width: 35px;
			height: 35px;
			background: linear-gradient(135deg, var(--primary-color) 0%, #825ee4 100%);
			border-radius: 8px;
			display: flex;
			align-items: center;
			justify-content: center;
			color: white;
			font-size: 1rem;
			flex-shrink: 0;
		}

		kbd {
			background: linear-gradient(135deg, var(--text-primary) 0%, var(--text-secondary) 100%);
			color: white;
			padding: 4px 10px;
			border-radius: 6px;
			font-size: 0.85rem;
			font-weight: 600;
			box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
		}

		.about-stats {
			display: flex;
			justify-content: space-around;
			gap: 15px;
			margin: 25px 0;
		}

		.stat-card {
			flex: 1;
			background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
			padding: 20px;
			border-radius: 12px;
			text-align: center;
			transition: all 0.3s ease;
		}

		.stat-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
		}

		.stat-number {
			font-size: 2rem;
			color: var(--primary-color);
			display: block;
			margin-bottom: 8px;
		}

		.stat-label {
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--text-primary);
		}

		@media (max-width: 768px) {
			.header h1 {
				font-size: 1.5rem;
			}

			.tab-content {
				padding: 20px 15px;
			}

			.settings-section {
				padding: 20px;
			}

			.btn-action {
				width: 100%;
				justify-content: center;
				margin-bottom: 10px;
			}

			.about-stats {
				flex-direction: column;
			}
		}
	</style>
</head>
<body>
	<div class="options-container">
		<!-- Header -->
		<div class="header">
			<div class="header-content">
				<h1><i class="bi bi-play-circle-fill"></i> YouTube Playback Speed Control</h1>
				<p>Customize your video playback experience</p>
			</div>
		</div>

		<!-- Time Saved Badge -->
		<div class="time-saved-badge">
			<i class="bi bi-clock-history"></i>
			<div class="time-saved-content">
				<h5>Time Saved</h5>
				<p id="totalSavedTime">Loading...</p>
			</div>
		</div>

		<!-- Navigation Tabs -->
		<ul class="nav nav-tabs" id="mainTab" role="tablist">
			<li class="nav-item" role="presentation">
				<button class="nav-link active" id="HomeTab" data-bs-toggle="tab" data-bs-target="#home" type="button" role="tab">
					<i class="bi bi-house-door-fill"></i> Getting Started
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="SettingsTab" data-bs-toggle="tab" data-bs-target="#settings" type="button" role="tab">
					<i class="bi bi-gear-fill"></i> Settings
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="AboutTab" data-bs-toggle="tab" data-bs-target="#about" type="button" role="tab">
					<i class="bi bi-info-circle-fill"></i> About
				</button>
			</li>
		</ul>

		<!-- Tab Content -->
		<div class="tab-content" id="mainTabContent">
			
			<!-- Getting Started Tab -->
			<div class="tab-pane fade show active" id="home" role="tabpanel">
				<div class="welcome-card">
					<h2 class="h3 fw-bold mb-3">
						<i class="bi bi-rocket-takeoff-fill"></i> Welcome aboard!
					</h2>
					<p class="lead mb-0">Control video playback speed like a pro with keyboard shortcuts and intuitive controls.</p>
				</div>

				<div class="settings-section">
					<div class="section-header">
						<div class="section-icon">
							<i class="bi bi-keyboard-fill"></i>
						</div>
						<h3 class="section-title">Default Keyboard Shortcuts</h3>
					</div>
					
					<ul class="feature-list">
						<li>
							<div class="feature-icon"><i class="bi bi-plus-lg"></i></div>
							<div>
								<kbd>+</kbd> or <kbd>=</kbd> <strong>Increase playback speed</strong>
							</div>
						</li>
						<li>
							<div class="feature-icon"><i class="bi bi-dash-lg"></i></div>
							<div>
								<kbd>-</kbd> or <kbd>_</kbd> <strong>Decrease playback speed</strong>
							</div>
						</li>
						<li>
							<div class="feature-icon"><i class="bi bi-arrow-repeat"></i></div>
							<div>
								<kbd>*</kbd> (Numpad) <strong>Reset to 1x speed</strong>
							</div>
						</li>
						<li>
							<div class="feature-icon"><i class="bi bi-mouse-fill"></i></div>
							<div>
								<kbd>Shift</kbd> + <kbd>Mouse Wheel</kbd> <strong>Adjust with scroll</strong>
							</div>
						</li>
					</ul>
				</div>

				<div class="settings-section">
					<div class="section-header">
						<div class="section-icon">
							<i class="bi bi-display-fill"></i>
						</div>
						<h3 class="section-title">On-Screen Controls</h3>
					</div>
					
					<p class="mb-3">A sleek control panel appears on your videos featuring:</p>
					<div class="row g-3">
						<div class="col-6 col-md-3">
							<div class="text-center p-3 bg-light rounded-3">
								<div class="h2 text-primary mb-2">&gt;&gt;</div>
								<small class="fw-bold">Speed Up</small>
							</div>
						</div>
						<div class="col-6 col-md-3">
							<div class="text-center p-3 bg-light rounded-3">
								<div class="h2 text-primary mb-2">1.25x</div>
								<small class="fw-bold">Current Speed</small>
							</div>
						</div>
						<div class="col-6 col-md-3">
							<div class="text-center p-3 bg-light rounded-3">
								<div class="h2 text-primary mb-2">&lt;&lt;</div>
								<small class="fw-bold">Slow Down</small>
							</div>
						</div>
						<div class="col-6 col-md-3">
							<div class="text-center p-3 bg-light rounded-3">
								<div class="h2 text-primary mb-2"><i class="bi bi-gear-fill"></i></div>
								<small class="fw-bold">Settings</small>
							</div>
						</div>
					</div>
				</div>

				<div class="tip-box">
					<strong><i class="bi bi-lightbulb-fill"></i> Pro Tip:</strong> Head over to the <strong>Settings</strong> tab to customize keyboard shortcuts, speed increments, display options, and more!
				</div>
			</div>

			<!-- Settings Tab -->
			<div class="tab-pane fade" id="settings" role="tabpanel">
				
				<!-- Status Alert -->
				<div id="status" class="alert"></div>

				<!-- Keyboard Controls -->
				<div class="settings-section">
					<div class="section-header">
						<div class="section-icon">
							<i class="bi bi-keyboard-fill"></i>
						</div>
						<h3 class="section-title">Keyboard Shortcuts</h3>
					</div>
					<div class="row g-3">
						<div class="col-md-4">
							<label for="slowerKeyInput" class="form-label">
								<i class="bi bi-dash-circle-fill text-danger"></i> Decrease Speed
							</label>
							<select id="slowerKeyInput" class="form-select"></select>
						</div>
						<div class="col-md-4">
							<label for="fasterKeyInput" class="form-label">
								<i class="bi bi-plus-circle-fill text-success"></i> Increase Speed
							</label>
							<select id="fasterKeyInput" class="form-select"></select>
						</div>
						<div class="col-md-4">
							<label for="resetKeyInput" class="form-label">
								<i class="bi bi-arrow-repeat text-primary"></i> Reset Speed
							</label>
							<select id="resetKeyInput" class="form-select"></select>
						</div>
					</div>
				</div>

				<!-- Speed Settings -->
				<div class="settings-section">
					<div class="section-header">
						<div class="section-icon">
							<i class="bi bi-speedometer"></i>
						</div>
						<h3 class="section-title">Speed Configuration</h3>
					</div>
					<div class="row g-3">
						<div class="col-md-6">
							<label for="speedStep" class="form-label">
								<i class="bi bi-lightning-fill text-warning"></i> Speed Change Step
							</label>
							<input id="speedStep" type="number" step="0.05" min="0.05" max="1" class="form-control" placeholder="0.25"/>
							<small class="text-muted d-block mt-2">
								<i class="bi bi-info-circle"></i> Amount of speed change per keypress (0.05 to 1.0)
							</small>
						</div>
					</div>
				</div>

				<!-- General Options -->
				<div class="settings-section">
					<div class="section-header">
						<div class="section-icon">
							<i class="bi bi-toggles2"></i>
						</div>
						<h3 class="section-title">General Options</h3>
					</div>
					<div class="row g-3">
						<div class="col-md-6">
							<div class="form-check form-switch">
								<input class="form-check-input" type="checkbox" id="allowMouseWheel">
								<label class="form-check-label" for="allowMouseWheel">
									<i class="bi bi-mouse2-fill"></i> Enable Shift + Mouse Wheel control
